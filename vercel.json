{
  "routes": [
    { "src": "/embed", "dest": "/index.html" },
    { "src": "/test", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/$1" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *;" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
} 