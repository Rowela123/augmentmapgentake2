{
  "rewrites": [
    { "source": "/embed", "destination": "/index.html" },
    { "source": "/embed/:id", "destination": "/index.html" },
    { "source": "/test", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *;" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
} 